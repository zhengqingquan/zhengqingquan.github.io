// Mist: pin sidebar on desktop; animate only when user toggles
+desktop-large() {
  .sidebar-dimmer {
    display: none !important;
  }

  .sidebar {
    left: 0;
    // Override theme transition — animation only with .sidebar-animating
    transition: none;
  }

  body {
    padding-left: $sidebar-width-expanded;
    transition: none;
  }

  .footer-fixed {
    left: $sidebar-width-expanded;
    transition: none;
  }

  // Toggle: dock to sidebar's right edge and follow it
  .sidebar-toggle {
    top: 50%;
    right: auto;
    bottom: auto;
    left: $sidebar-width-expanded;
    width: 16px;
    height: 56px;
    padding: 0;
    border-radius: 0 8px 8px 0;
    background: $black-deep;
    box-shadow: 2px 0 8px rgba(0, 0, 0, .18);
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translateY(-50%);
    transition: none;
    color: $gainsboro;
    font-size: 18px;
    font-weight: 600;
    line-height: 1;
  }

  // Hide theme hamburger / morph lines; use text glyphs instead
  .sidebar-toggle .toggle-line {
    display: none !important;
    transition: none !important;
  }

  // Default expanded = < (no wait for sidebar-active). Collapsed = >
  .sidebar-toggle::before {
    content: '<';
  }

  html.sidebar-user-collapsed .sidebar-toggle::before,
  body.sidebar-user-collapsed .sidebar-toggle::before {
    content: '>';
  }

  .sidebar-toggle:hover {
    background: lighten($black-deep, 8%);
    color: $sidebar-highlight;
  }

  // html class: set in <head> before paint; body class: toggled later by JS
  html.sidebar-user-collapsed .sidebar-toggle,
  body.sidebar-user-collapsed .sidebar-toggle {
    left: 0;
  }

  body.sidebar-animating {
    transition: padding-left 0.2s ease-out;

    .sidebar {
      transition: left 0.2s ease-out;
    }

    .footer-fixed {
      transition: left 0.2s ease-out;
    }

    .sidebar-toggle {
      transition: left 0.2s ease-out;
    }
  }

  html.sidebar-user-collapsed body,
  body.sidebar-user-collapsed {
    padding-left: 0;
  }

  html.sidebar-user-collapsed .sidebar,
  body.sidebar-user-collapsed .sidebar {
    left: 0 - $sidebar-width-expanded;
  }

  html.sidebar-user-collapsed .footer-fixed,
  body.sidebar-user-collapsed .footer-fixed {
    left: 0;
  }
}
