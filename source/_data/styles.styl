// Post title hover: blue text + scallop; no underline
.posts-expand .post-title-link {
  transition: color .2s ease;
}

.posts-expand .post-title-link::before {
  display: none !important;
}

.posts-expand .post-title-link:hover {
  color: #1aa3e0;
}

.posts-expand .post-title-link::after {
  content: '';
  position: absolute;
  left: 100%;
  top: 50%;
  width: 1em;
  height: 1em;
  margin-left: .2em;
  background: url('/images/scallop.svg') center / contain no-repeat;
  opacity: 0;
  transform: translate(-2px, calc(-50% - 3px)) scale(.85);
  transition: opacity .2s ease, transform .2s ease;
  pointer-events: none;
}

.posts-expand .post-title-link:hover::after {
  opacity: 1;
  transform: translate(-2px, calc(-50% - 3px)) scale(1);
}

// Hide colored dots before sidebar social links
.links-of-author a::before {
  display: none !important;
}

// Mist hides post separators by default — show a divider between posts
.posts-expand .post-eof {
  display: block;
  background: $grey-light;
  height: 1px;
  width: 100%;
  margin: 48px auto 48px;
}

.posts-expand .post-block:not(:first-of-type) {
  margin-top: 0;
}

.posts-expand .post-block:last-of-type .post-eof {
  display: none;
}

// No dashed underline on publish time
.posts-expand .post-meta-container time {
  border-bottom: 0;
}

// Category / tag page: post count under title
.posts-collapse .collection-title .collection-taxonomy-count {
  color: $grey;
  display: block;
  font-size: $font-size-small;
  font-weight: normal;
  margin-top: .35em;
}

// Copyright + busuanzi at sidebar bottom
.sidebar-footer {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  padding: 14px 12px 18px;
  text-align: center;
  font-size: $font-size-smallest;
  line-height: 1.8;
  color: $grey-dark;
  background: linear-gradient(to top, $black-deep 70%, transparent);
}

.sidebar-footer .copyright,
.sidebar-footer .busuanzi-count,
.sidebar-footer .author {
  color: $grey-dark;
}

.sidebar-footer .with-love {
  display: none;
}

.sidebar-footer .busuanzi-count {
  margin-top: 2px;
}

.sidebar-footer .post-meta-item {
  margin: 0 .35em;
}

.sidebar > .sidebar-inner {
  padding-bottom: 72px;
}

// Page footer becomes empty after move
.footer {
  display: none !important;
}

// Mist: pin sidebar on desktop; animate only when user toggles
+desktop-large() {
  .sidebar-dimmer {
    display: none !important;
  }

  .sidebar {
    left: 0;
    // Override theme transition — animation only with .sidebar-animating
    transition: none;
  }

  body {
    padding-left: $sidebar-width-expanded;
    transition: none;
  }

  .footer-fixed {
    left: $sidebar-width-expanded;
    transition: none;
  }

  // Toggle: dock to sidebar's right edge and follow it
  .sidebar-toggle {
    top: 50%;
    right: auto;
    bottom: auto;
    left: $sidebar-width-expanded;
    width: 16px;
    height: 56px;
    padding: 0;
    border-radius: 0 8px 8px 0;
    background: $black-deep;
    box-shadow: 2px 0 8px rgba(0, 0, 0, .18);
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translateY(-50%);
    transition: none;
    color: $gainsboro;
    font-size: 18px;
    font-weight: 600;
    line-height: 1;
  }

  // Hide theme hamburger / morph lines; use text glyphs instead
  .sidebar-toggle .toggle-line {
    display: none !important;
    transition: none !important;
  }

  // Default expanded = < (no wait for sidebar-active). Collapsed = >
  .sidebar-toggle::before {
    content: '<';
  }

  html.sidebar-user-collapsed .sidebar-toggle::before,
  body.sidebar-user-collapsed .sidebar-toggle::before {
    content: '>';
  }

  .sidebar-toggle:hover {
    background: lighten($black-deep, 8%);
    color: $sidebar-highlight;
  }

  // html class: set in <head> before paint; body class: toggled later by JS
  html.sidebar-user-collapsed .sidebar-toggle,
  body.sidebar-user-collapsed .sidebar-toggle {
    left: 0;
  }

  body.sidebar-animating {
    transition: padding-left 0.2s ease-out;

    .sidebar {
      transition: left 0.2s ease-out;
    }

    .footer-fixed {
      transition: left 0.2s ease-out;
    }

    .sidebar-toggle {
      transition: left 0.2s ease-out;
    }
  }

  html.sidebar-user-collapsed body,
  body.sidebar-user-collapsed {
    padding-left: 0;
  }

  html.sidebar-user-collapsed .sidebar,
  body.sidebar-user-collapsed .sidebar {
    left: 0 - $sidebar-width-expanded;
  }

  html.sidebar-user-collapsed .footer-fixed,
  body.sidebar-user-collapsed .footer-fixed {
    left: 0;
  }
}
