// Mist: pin sidebar on desktop (keep drawer on smaller screens)
+desktop-large() {
  .sidebar-dimmer {
    display: none !important;
  }

  .sidebar {
    left: 0 !important;
  }

  body {
    padding-left: $sidebar-width-expanded;
  }

  .footer-fixed {
    left: $sidebar-width-expanded;
  }

  .sidebar-toggle {
    display: none;
  }
}
